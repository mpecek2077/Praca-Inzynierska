# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep only .env.example)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript / generated
next-env.d.ts
/src/generated/prisma

# uploaded custom 3D models (keep folder via .gitkeep)
/public/uploads/custom/*
!/public/uploads/custom/.gitkeep

